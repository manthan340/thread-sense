# Copy to apps/api/.env and apps/web/.env.local as needed

# API
PORT=3001
DATABASE_URL=postgresql://thread:thread@localhost:5433/thread_sense?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=thread-sense
MINIO_REGION=us-east-1

# SMTP (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Thread Sense <noreply@thread-sense.local>"

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
